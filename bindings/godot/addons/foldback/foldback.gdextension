[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = "4.1"
reloadable = true

[libraries]
windows.debug.x86_64 = "res://addons/foldback/bin/foldback_godot.dll"
windows.release.x86_64 = "res://addons/foldback/bin/foldback_godot.dll"
linux.debug.x86_64 = "res://addons/foldback/bin/libfoldback_godot.so"
linux.release.x86_64 = "res://addons/foldback/bin/libfoldback_godot.so"
macos.debug = "res://addons/foldback/bin/libfoldback_godot.dylib"
macos.release = "res://addons/foldback/bin/libfoldback_godot.dylib"
