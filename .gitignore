/target
.claude/
*.pdb
/docs/book
crates/foldback-ui/gen/
bindings/unity/Tests~/FoldbackSys.Tests/bin/
bindings/unity/Tests~/FoldbackSys.Tests/obj/

# examples/unity-demo — standard Unity-generated project directories, plus
# the native library CI/local builds copy in before an IL2CPP build (never
# committed, see bindings/unity's own README for why).
examples/unity-demo/Library/
examples/unity-demo/Build/
examples/unity-demo/Logs/
examples/unity-demo/UserSettings/
examples/unity-demo/obj/
examples/unity-demo/*.csproj
examples/unity-demo/*.sln
examples/unity-demo/*.slnx
examples/unity-demo/Assets/Plugins/

# examples/godot-demo and bindings/godot — Godot's own generated project
# cache, plus the compiled native library CI/local builds copy into the
# addon's bin/ folder (never committed, same pattern as the Unity plugin
# native libs above).
examples/godot-demo/.godot/
examples/godot-demo/addons/foldback/bin/
bindings/godot/addons/foldback/bin/
