/target
.claude/
*.pdb
/docs/book
crates/foldback-ui/gen/
bindings/unity/Tests~/FoldbackSys.Tests/bin/
bindings/unity/Tests~/FoldbackSys.Tests/obj/

# examples/unity-demo — standard Unity-generated project directories, plus
# the native library CI/local builds copy in before an IL2CPP build (never
# committed, see bindings/unity's own README for why).
examples/unity-demo/Library/
examples/unity-demo/Build/
examples/unity-demo/Logs/
examples/unity-demo/UserSettings/
examples/unity-demo/obj/
examples/unity-demo/*.csproj
examples/unity-demo/*.sln
examples/unity-demo/*.slnx
examples/unity-demo/Assets/Plugins/

# examples/godot-demo and bindings/godot — Godot's own generated project
# cache, plus the compiled native library CI/local builds copy into the
# addon's bin/ folder (never committed, same pattern as the Unity plugin
# native libs above).
examples/godot-demo/.godot/
examples/godot-demo/addons/foldback/bin/
bindings/godot/addons/foldback/bin/

# bindings/unreal and examples/unreal-demo — the cbindgen-generated header
# and the compiled foldback-sys static lib, both staged by CI/local builds
# before the plugin compiles (never committed, same "regenerate, don't
# commit binaries" pattern as the Unity/Godot native libs above).
bindings/unreal/Source/ThirdParty/Foldback/include/
bindings/unreal/Source/ThirdParty/Foldback/Win64/
bindings/unreal/Source/ThirdParty/Foldback/Linux/
bindings/unreal/Source/ThirdParty/Foldback/Mac/
bindings/unreal/Intermediate/
bindings/unreal/Binaries/
examples/unreal-demo/Binaries/
examples/unreal-demo/Intermediate/
examples/unreal-demo/Saved/
examples/unreal-demo/DerivedDataCache/
examples/unreal-demo/*.sln
examples/unreal-mass-demo/Binaries/
examples/unreal-mass-demo/Intermediate/
examples/unreal-mass-demo/Saved/
examples/unreal-mass-demo/DerivedDataCache/
examples/unreal-mass-demo/*.sln
examples/unreal-mass-demo/Plugins/Foldback/
examples/unreal-demo/Plugins/Foldback/
